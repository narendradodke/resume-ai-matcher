# ==============================================================================
# Resume AI Matcher — Frontend Environment Configuration
# ==============================================================================
#
# IMPORTANT:
# In Next.js, variables prefixed with `NEXT_PUBLIC_` are statically inlined
# at BUILD TIME into the client JavaScript bundle.
#
# For Local Development:
# Copy this file to `frontend/.env.local` or run with default fallback:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
#
# For Vercel / Cloud Deployments:
# Configure `NEXT_PUBLIC_API_BASE_URL` in your Vercel Project Settings:
# Settings -> Environment Variables -> Select Production, Preview, Development.
# Must point to your live backend endpoint, e.g.:
# NEXT_PUBLIC_API_BASE_URL=https://resume-matcher-backend.onrender.com/api/v1
# (Note: Omit trailing slashes; do not point to localhost in production!)
# ==============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
